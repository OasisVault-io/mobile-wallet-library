{
  "name": "rn-multisig-wallet",
  "version": "0.1.0",
  "description": "Library that allows the creation of multisig wallets in BTC and ETH ",
  "keywords": [
    "android",
    "ios",
    "react-native"
  ],
  "homepage": "https://github.com/OasisVault-io/rn-multisig-wallet#readme",
  "bugs": {
    "url": "https://github.com/OasisVault-io/rn-multisig-wallet/issues"
  },
  "license": "MIT",
  "author": "OasisVault <dev@oasisvault.io> (https://github.com/dev-ov)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OasisVault-io/rn-multisig-wallet.git"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "example": "pnpm --filter rn-multisig-wallet-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "jest",
    "release": "release-it --only-version"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.0",
    "@jest/globals": "^30.0.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/react": "^19.2.0",
    "commitlint": "^20.5.0",
    "del-cli": "^7.0.0",
    "jest": "^30.3.0",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-builder-bob": "0.39.0",
    "release-it": "^19.2.4",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "preset": "@react-native/jest-preset"
  },
  "engines": {
    "node": ">=20.19.4",
    "pnpm": ">=10.12.2"
  },
  "volta": {
    "node": "24.13.0",
    "pnpm": "10.12.2"
  },
  "packageManager": "pnpm@10.12.2",
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "jest",
      "lefthook",
      "oxfmt",
      "oxlint",
      "release-it"
    ],
    "version": "0.62.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  }
}
